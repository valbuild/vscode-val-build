{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["es2020", "DOM"],
    // `node16` rather than classic `node`/node10: vscode-languageserver 10 ships
    // an `exports` map, so `vscode-languageserver/node` is unresolvable without
    // it (and TypeScript 6 rejects node10 outright as deprecated). The emit stays
    // CommonJS, because server/package.json declares no `"type": "module"`.
    "module": "node16",
    "moduleResolution": "node16",
    "sourceMap": true,
    "strict": true,
    "outDir": "out",
    "rootDir": "src",
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules", ".vscode-test", "__fixtures__"]
}
