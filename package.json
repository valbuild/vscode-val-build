{
  "name": "vscode-val-build",
  "description": "Val Build IntelliSense",
  "author": "Val Build",
  "icon": "images/icon.png",
  "license": "MIT",
  "version": "1.0.23",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/valbuild/vscode-val-build.git"
  },
  "publisher": "valbuild",
  "categories": [],
  "keywords": [
    "multi-root ready"
  ],
  "displayName": "Val Build IntelliSense",
  "engines": {
    "vscode": "^1.91.0"
  },
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:javascript"
  ],
  "main": "./client/out/extension.js",
  "type": "module",
  "contributes": {
    "commands": [
      {
        "command": "val.login",
        "title": "Val: Log In"
      },
      {
        "command": "val.showLanguageServerInfo",
        "title": "Val: Show Language Server Info"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Val Build IntelliSense",
      "properties": {
        "valBuild.languageServerPath": {
          "scope": "window",
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to a `@valbuild/language-server` entry point, used instead of resolving one from the project's `node_modules`.\n\nNeeded under Yarn PnP, where there is no `node_modules` to resolve through, and useful for developing against an unreleased Val by pointing at a monorepo checkout's `packages/language-server/bin.js`. The `VAL_LANGUAGE_SERVER_PATH` environment variable does the same and is used when this is empty."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run esbuild-base -- --minify",
    "esbuild-base": "esbuild ./client/src/extension.ts --bundle --outfile=client/out/extension.js --external:vscode --format=cjs --platform=node",
    "esbuild": "npm run esbuild-base -- --sourcemap",
    "esbuild-watch": "npm run esbuild-base -- --sourcemap --watch",
    "compile": "tsc -b",
    "watch": "tsc -b -w",
    "lint": "eslint client/src",
    "postinstall": "cd client && npm install",
    "test": "sh ./scripts/e2e.sh",
    "install-fixtures": "cd fixtures && (cd npm && npm ci --no-audit --no-fund) && (cd old-val && npm ci --no-audit --no-fund) && (cd pnpm && pnpm install --ignore-workspace --frozen-lockfile) && (cd yarn && yarn install --immutable)",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "mocha": "^11.8.0",
    "typescript": "^5.9.3"
  }
}
